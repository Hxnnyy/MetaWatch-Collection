{
  "version": "3.0",
  "workflow": {
    "name": "MetaWatch Longflow (opinionated)"
  },
  "harness": {
    "orchestrator": "claude-code",
    "subagentDispatchStyle": "named-agent",
    "supportsParallelSubagents": true
  },
  "tier": {
    "default": "propose",
    "blockForApprovalAt": ["T3"],
    "policyFixture": "shared/orchestration/tier-policy.json"
  },
  "modelAliases": {
    "frontier-anthropic-strong": "Claude Fable 5",
    "frontier-anthropic-fast": "Claude Sonnet 5",
    "frontier-openai-strong": "GPT-5.6-Sol",
    "frontier-openai-fast": "GPT-5.6-Terra",
    "frontier-google": "Gemini 3.1 Pro",
    "frontier-xai": "Grok 4.5"
  },
  "models": {
    "councilChair": {
      "alias": "frontier-google",
      "reasoning": "high",
      "rationale": "Independent of any council member's lab to avoid intra-lab homogenization on dispositions."
    },
    "council": [
      "frontier-anthropic-strong",
      "frontier-openai-strong",
      "frontier-xai"
    ]
  },
  "routing": {
    "intentAuditor": "frontier-anthropic-strong",
    "leadByIssueType": {
      "frontend": "frontier-anthropic-fast",
      "backend": "frontier-openai-fast",
      "security": "frontier-openai-fast",
      "docs": "frontier-openai-fast"
    },
    "reviewersByIssueType": {
      "frontend": [
        "frontier-google",
        "frontier-openai-fast"
      ],
      "backend": [
        "frontier-openai-fast",
        "frontier-anthropic-fast"
      ],
      "security": [
        "frontier-openai-fast",
        "frontier-anthropic-fast"
      ],
      "docs": [
        "frontier-openai-fast",
        "frontier-anthropic-fast"
      ]
    },
    "promiseGateReviewers": [
      "frontier-openai-fast",
      "frontier-anthropic-fast",
      "frontier-google"
    ],
    "finalCloseoutModels": [
      "frontier-openai-fast",
      "frontier-anthropic-fast",
      "frontier-google"
    ],
    "finalCloseoutPersonas": [
      "implementation-reviewer",
      "product-reviewer",
      "operations-reviewer",
      "security-reviewer"
    ]
  },
  "adjudication": {
    "providers": [
      "codex exec",
      "cursor-agent",
      "grok"
    ],
    "fallback": "same-provider-skeptic"
  },
  "council": {
    "maxRounds": 1,
    "t3MaxRounds": 2,
    "severityDowngradeRequiresChairSignoff": true
  },
  "guardrails": {
    "requireFreshBranch": true,
    "requireFreshWorktree": true,
    "protectedEnvironment": [
      "telephony",
      "db-mock",
      "api",
      "webapp"
    ],
    "orchestratorDelegationDefault": true,
    "maxImplementerRetryPerIssue": 3,
    "reviewCycleBudgetPerGate": 3
  }
}

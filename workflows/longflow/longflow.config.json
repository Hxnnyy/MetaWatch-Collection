{
  "version": "2.0",
  "workflow": {
    "name": "MetaWatch Longflow",
    "continuousModeDefault": true,
    "pauseOnlyOnHardBlocks": true
  },
  "harness": {
    "orchestrator": "claude-code",
    "subagentDispatchStyle": "named-agent",
    "supportsParallelSubagents": true
  },
  "tier": {
    "default": "propose",
    "blockForApprovalAt": ["T3"]
  },
  "modelAliases": {
    "frontier-anthropic-strong": "Claude Fable 5",
    "frontier-anthropic-fast": "Claude Sonnet 5",
    "frontier-openai-strong": "GPT-5.6-Sol",
    "frontier-openai-fast": "GPT-5.6-Terra",
    "frontier-google": "Gemini 3.1 Pro",
    "frontier-xai": "Grok 4.5",
    "frontier-oss": "OSS-frontier"
  },
  "models": {
    "councilChair": {
      "alias": "frontier-oss",
      "reasoning": "high",
      "rationale": "Independent of any council member's lab to avoid intra-lab homogenization on dispositions."
    },
    "council": [
      "frontier-anthropic-strong",
      "frontier-openai-strong",
      "frontier-google",
      "frontier-xai"
    ]
  },
  "routing": {
    "intentAuditor": "frontier-anthropic-strong",
    "leadByIssueType": {
      "frontend": "frontier-anthropic-fast",
      "backend": "frontier-openai-fast",
      "security": "frontier-openai-fast",
      "docs": "frontier-openai-fast"
    },
    "reviewersByIssueType": {
      "frontend": ["frontier-google", "frontier-openai-fast"],
      "backend": ["frontier-openai-fast", "frontier-anthropic-fast"],
      "security": ["frontier-openai-fast", "frontier-anthropic-fast"],
      "docs": ["frontier-openai-fast", "frontier-anthropic-fast"]
    },
    "promiseGateReviewers": [
      "frontier-openai-fast",
      "frontier-anthropic-fast",
      "frontier-google"
    ],
    "finalCloseoutModels": [
      "frontier-openai-fast",
      "frontier-anthropic-fast",
      "frontier-google"
    ],
    "finalCloseoutPersonas": [
      "implementation-reviewer",
      "product-reviewer",
      "operations-reviewer",
      "security-reviewer"
    ]
  },
  "adjudication": {
    "providers": ["codex exec", "cursor-agent", "grok"],
    "fallback": "same-provider-skeptic"
  },
  "council": {
    "maxRounds": 1,
    "t3MaxRounds": 2,
    "severityDowngradeRequiresChairSignoff": true
  },
  "guardrails": {
    "requireFreshBranch": true,
    "requireFreshWorktree": true,
    "protectedEnvironment": [
      "telephony",
      "db-mock",
      "api",
      "webapp"
    ],
    "orchestratorDelegationDefault": true,
    "maxImplementerRetryPerIssue": 3,
    "reviewCycleBudgetPerGate": 3
  },
  "autonomyEnvelope": {
    "green": [
      "run-extra-tests",
      "add-missing-regression-tests",
      "local-refactor-within-scope",
      "split-internal-subtasks",
      "rerun-impacted-reviewers",
      "update-ledger-and-budget",
      "continue-after-non-hard-block-uncertainty",
      "breakglass-below-tier-defaults",
      "act-on-binding-descope-verdict"
    ],
    "amber": [
      "change-production-item-checks",
      "broaden-remediation-scope",
      "reslice-ledger",
      "change-reviewer-requirements",
      "accept-non-trivial-residual-risk",
      "add-ceremony-above-tier-defaults",
      "change-run-tier"
    ],
    "red": [
      "material-ambiguous-product-semantics",
      "missing-required-credentials",
      "irreconcilable-reviewer-contradiction",
      "migration-data-loss-security-tradeoff",
      "state-corruption",
      "irreversible-destructive-action"
    ]
  },
  "closurePolicy": {
    "walkthroughRequiredAtEveryGate": true,
    "intentAuditRequiredAtGatesFromTier": "T2",
    "predicatePassRequired": true,
    "predicatePassSufficient": false,
    "predicateAdequacyReviewRequired": true,
    "testAdequacyReviewRequired": true,
    "allowPassWithNotesAtFinalCloseout": false,
    "courseCorrectionProposalRequiredForCheckChanges": true,
    "retroRequiredAtCloseout": true
  }
}
